+
+#[test]
+fn checked_leaf_header_reused_for_hits_and_cursor_rows() {
+    use std::ops::Bound::{Excluded, Included};
+
+    fn value(n: u8) -> Vec<u8> {
+        if n.is_multiple_of(16) {
+            vec![n; 2048]
+        } else {
+            vec![n; 12]
+        }
+    }
+    let mut tree = PersistentBTree::new();
+    let root = tree.bulk_load((0u8..96).map(|n| (vec![2 * n], value(n))));
+    LEAF_HEADERS.with(|c| c.set(0));
+    assert_eq!(tree.get(root, &[0]), Some(value(0)));
+    let overflow_hit = LEAF_HEADERS.with(|c| c.replace(0));
+    assert_eq!(tree.get(root, &[2]), Some(value(1)));
+    let inline_hit = LEAF_HEADERS.with(|c| c.replace(0));
+    assert_eq!(tree.get(root, &[3]), None);
+    let miss = LEAF_HEADERS.with(|c| c.replace(0));
+    let rows = tree
+        .range(root, Excluded(&[0]), Included(&[190]))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        rows,
+        (1u8..96)
+            .map(|n| (vec![2 * n], value(n)))
+            .collect::<Vec<_>>()
+    );
+    let scan = LEAF_HEADERS.with(|c| c.replace(0));
+    assert_eq!((overflow_hit, inline_hit, miss, scan), (1, 1, 1, 3));
+}
