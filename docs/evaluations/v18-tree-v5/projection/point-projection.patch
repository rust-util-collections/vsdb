+// Disk leaves need only the selected slot. The decoder finishes while the
+// MMDB backing remains pinned. A writer can also own an unpublished page.
+enum LeafStore<'a> {
+    Map(&'a MapxRaw, Option<&'a HashMap<NodeId, Vec<u8>>>),
+    Reader(&'a MapxRawReader),
+}
+
+impl LeafStore<'_> {
+    fn project<T>(self, id: NodeId, read: impl FnOnce(&[u8]) -> T) -> T {
+        #[cfg(test)]
+        NODE_READS.with(|c| c.set(c.get() + 1));
+        if let Self::Map(_, Some(pending)) = &self
+            && let Some(bytes) = pending.get(&id)
+        {
+            return read(bytes);
+        }
+        let key = object_key(id);
+        let decode = |raw: &[u8]| Ok(read(raw));
+        match self {
+            Self::Map(nodes, _) => nodes.try_get_with(key, decode),
+            Self::Reader(nodes) => nodes.try_get_with(key, decode),
+        }
+        .unwrap_or_else(|error| {
+            panic!("PersistentBTree: failed to read leaf {id}: {error}")
+        })
+        .unwrap_or_else(|| panic!("PersistentBTree: missing object {id}"))
+    }
+}
