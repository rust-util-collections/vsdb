@@ -1815,3 +1815,38 @@ mod diff_merge {
         assert!(small.used_bytes() <= 64 * 1024);
     }
 }
+
+#[test]
+fn projected_leaf_preserves_pending_pages_blobs_and_owned_results() {
+    let mut tree = PersistentBTree::new();
+    let payload = vec![0x5c; 4096];
+    let blob = tree.alloc_object(BLOB, payload.clone(), Vec::new());
+    let root = tree.alloc(&Node::Leaf {
+        keys: vec![b"a".to_vec(), b"b".to_vec(), b"c".to_vec()],
+        values: vec![
+            LeafVal::Bytes(Vec::new()),
+            LeafVal::Blob(blob),
+            LeafVal::Bytes(b"inline".to_vec()),
+        ],
+    });
+    assert!(tree.pending.contains_key(&root) && tree.pending.contains_key(&blob));
+    for _ in 0..2 {
+        assert_eq!(tree.get(root, b"a").as_deref(), Some(&[][..]));
+        assert_eq!(tree.get(root, b"b"), Some(payload.clone()));
+        let owned = tree.get(root, b"c").unwrap();
+        assert!(tree.contains_key(root, b"b"));
+        assert!(!tree.contains_key(root, b"no"));
+        assert!(tree.get(root, b"no").is_none());
+        tree.flush_pending();
+        assert_eq!(owned, b"inline");
+        assert!(!tree.pending.contains_key(&root));
+    }
+    assert_eq!(tree.get_committed(root, b"b"), Some(payload.clone()));
+    assert!(tree.contains_committed(root, b"a"));
+    tree.acquire_node(root);
+    let lease = tree.lease_root(|_| Ok(root)).unwrap();
+    tree.release_node(root);
+    assert_eq!(lease.get(b"b"), Some(payload));
+    assert!(lease.contains_key(b"a"));
+    assert!(!lease.contains_key(b"no"));
+}
