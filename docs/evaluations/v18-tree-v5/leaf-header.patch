+/// Owns an immutable page and the header checked against those exact bytes.
+pub(super) struct OwnedPage {
+    bytes: Vec<u8>,
+    slots: usize,
+    leaf: bool,
+}
+
+impl OwnedPage {
+    pub(super) fn open(bytes: Vec<u8>) -> Result<Self> {
+        let view = NodeView::open(&bytes)?;
+        Ok(Self {
+            slots: view.len,
+            leaf: view.leaf,
+            bytes,
+        })
+    }
+
+    pub(super) fn view(&self) -> NodeView<'_> {
+        NodeView {
+            raw: &self.bytes,
+            len: self.slots,
+            leaf: self.leaf,
+        }
+    }
+}
